# Parallelization
Partition : 3 3 1

# 
# Mesh definition
Lx : 1
Ly : 1
Lz : 1
nx : 64   !128
ny : 64    !128
nz : 64    !128

# Are we using a moving domain?
Two Dimensional : .true. 
# Fluid properties
Gravity :                     0 0 0
Liquid density :              1 
Gas density :                 1
Surface tension coefficient : 1
# Options
Marangoni :  0 0 0
Pressure : 1
Smoothing Option : 1
Surface Tension Option : 8
Reconstruction Type : 2
Curvature Option : 1
PU Spread : 2.0

# Simulation Parameters
Droplet Radius : 4.0e-1
Droplet Velocity : 0 0 0
Laplace Number : 120

# Time integration
Min Viscous Time :            1.0 # Changes Max Time
Min Capillary Time :          1.0 # This will almost never matter, as the viscous time is so much longer, but it is fine

# Time integration
Max timestep size : 0.4  # Default Values, Overriden
Max time :          0.08  # Default Values, Overriden

Timestep factor : 0.5 # Scale on Delta t_max. That is to say, we scale sqrt(rho*delta^3/(pi*sigma)), which is the max time step, by this value to get our Max time step.
Max cfl number :    0.8 # Changes Time Step
# Pressure solver
Pressure tolerance : 1e-12
Pressure iteration : 100

# Ensight output
Ensight output period : 1e-2