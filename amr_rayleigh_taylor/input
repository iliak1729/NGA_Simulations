# Mesh parameters
Base nx:                4
Base ny:                4
Base nz:                4
Max level:              4

# Regridding parameters
Regrid nsteps:          10
Blocking factor:        4
Max grid size:          8

# Rayleigh-Plateau parameters
Ligament radius:        0.10
Ligament center:        0 0 0
Perturbation amplitude: 0.02
Perturbation mode:      1

# Velocity field
Initial velocity:       0 0 0

# Fluid properties
Liquid dynamic viscosity:    1.0e-3
Gas dynamic viscosity:       1.8e-5
Liquid density:              1000
Gas density:                 1
Surface tension coefficient: 0.072

# Time integration
Max time:               60
Max dt:                 0.05
Max CFL:                0.25

# Output
Output period:          5e-2
Checkpoint period:      5e-2
