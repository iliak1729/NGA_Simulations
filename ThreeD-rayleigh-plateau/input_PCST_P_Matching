Max time:               10
Max timestep size:      0.05
Max cfl number:         0.1

# Pressure solver
Pressure tolerance : 1e-12
Pressure iteration : 100

# Implicit velocity solver
Implicit tolerance : 1e-12
Implicit iteration : 100

# Ensight output
Ensight output period : 1e-1
 
