# Parallelization
Partition : 2 2 4

# Mesh definition
Lx : 1.0
Ly : 1.0
Lz : 1.0
nx : 64
ny : 64
nz : 64

# monitor file name
Monitor File Name : rayleigh_plateau

# Ligament definiton
Ligament radius :           0.10
Ligament center :           0 0 0
Perturbation amplitude :    0.02
Perturbation mode :         1

